# ============================================
# PBL 科创育人平台 - 后端环境变量示例
# 复制为 .env 后按需修改
# ============================================

# 服务端口
PORT=3000

# API 路径前缀
API_PREFIX=/api

# JWT 签名密钥（生产环境强烈建议设置；不设置时后端会自动生成并持久化到 backend/.jwt-secret）
# 生成示例：openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_string

# 允许跨域的前端地址（开发时为 Vite 地址）
CORS_ORIGIN=http://localhost:5173

# 上传文件根目录（相对 backend 目录）
UPLOAD_PATH=./uploads

# SQLite 数据库路径（相对 backend 目录；自动化测试会覆盖为临时数据库）
DB_PATH=./database/pbl_platform.db

# 运行环境：development / production
NODE_ENV=development
