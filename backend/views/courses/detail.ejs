
<div class="page-header">
  <a href="/courses" class="btn btn-ghost">← 返回列表</a>
  <div>
    <% if (['admin', 'executive_mentor', 'academic_mentor'].includes(user.role)) { %>
      <a href="/courses/<%= course.id %>/edit" class="btn btn-sm">编辑课程</a>
    <% } %>
    <% if (['admin','executive_mentor'].includes(user.role)) { %>
      <form method="POST" action="/courses/<%= course.id %>/delete" style="display:inline" onsubmit="return confirm('确定删除此课程？')">
        <button type="submit" class="btn btn-sm btn-danger">删除</button>
      </form>
    <% } %>
  </div>
</div>

<!-- 课程信息 -->
<div class="detail-header">
  <h2><%= course.title %></h2>
  <div class="detail-meta">
    <% if (course.theme) { %><span class="tag"><%= course.theme %></span><% } %>
    <% const gradeMap = {primary:'小学',junior:'初中',senior:'高中'} %>
    <span class="tag"><%= gradeMap[course.grade_level] %></span>
    <% const diffMap = {basic:'基础版',advanced:'进阶版',challenge:'挑战版'} %>
    <span class="tag tag-<%= course.difficulty %>"><%= diffMap[course.difficulty] %></span>
    <span class="tag">创建者：<%= course.creator_name %></span>
  </div>
</div>

<div class="detail-grid">
  <div class="detail-main">
    <% if (course.driving_question) { %>
      <div class="info-block highlight">
        <h4>🎯 驱动问题</h4>
        <p class="driving-question"><%= course.driving_question %></p>
      </div>
    <% } %>

    <% if (course.story_line) { %>
      <div class="info-block">
        <h4>📖 故事线</h4>
        <p><%= course.story_line %></p>
      </div>
    <% } %>

    <% if (course.description) { %>
      <div class="info-block">
        <h4>📝 课程简介</h4>
        <p><%= course.description %></p>
      </div>
    <% } %>

    <% if (course.materials_needed) { %>
      <div class="info-block">
        <h4>🧰 材料清单</h4>
        <pre class="materials-list"><%= course.materials_needed %></pre>
      </div>
    <% } %>

    <!-- 课时列表 -->
    <div class="info-block">
      <h4>📅 课时安排</h4>
      <% if (lessons.length === 0) { %>
        <p class="text-muted">暂无课时</p>
      <% } else { %>
        <div class="lesson-list">
          <% lessons.forEach((lesson, i) => { %>
            <div class="lesson-item">
              <div class="lesson-header">
                <span class="lesson-number">第<%= i+1 %>课时</span>
                <strong><%= lesson.title %></strong>
                <% if (lesson.duration) { %><span class="lesson-duration"><%= lesson.duration %>分钟</span><% } %>
              </div>
              <% if (lesson.description) { %>
                <p class="lesson-desc"><%= lesson.description %></p>
              <% } %>
            </div>
          <% }) %>
        </div>
      <% } %>

      <!-- 添加课时 -->
      <% if (['admin', 'executive_mentor', 'academic_mentor'].includes(user.role)) { %>
        <form method="POST" action="/courses/<%= course.id %>/lesson" class="inline-form">
          <input type="text" name="title" placeholder="课时名称" required>
          <input type="text" name="description" placeholder="描述（选填）">
          <input type="number" name="duration" placeholder="时长（分钟）" style="width:120px" min="1">
          <button type="submit" class="btn btn-sm btn-primary">添加</button>
        </form>
      <% } %>
    </div>

    <!-- 资源列表 -->
    <div class="info-block">
      <h4>📎 课程资源</h4>
      <% if (resources.length === 0) { %>
        <p class="text-muted">暂无资源</p>
      <% } else { %>
        <table class="data-table">
          <thead><tr><th>名称</th><th>类型</th><th>大小</th><th>上传时间</th></tr></thead>
          <tbody>
          <% resources.forEach(r => { %>
            <tr>
              <td><%= r.title %></td>
              <td><% const typeMap = {lesson_plan:'教案',guide_card:'指南卡',template:'模板',courseware:'课件',video:'视频',other:'其他'} %><%= typeMap[r.resource_type] || r.resource_type %></td>
              <td><%= r.file_size ? (r.file_size / 1024).toFixed(0) + ' KB' : '-' %></td>
              <td><%= new Date(r.created_at).toLocaleDateString('zh-CN') %></td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      <% } %>

      <!-- 上传资源 -->
      <% if (['admin', 'executive_mentor', 'academic_mentor'].includes(user.role)) { %>
        <form method="POST" action="/courses/<%= course.id %>/resource" enctype="multipart/form-data" class="inline-form">
          <input type="text" name="title" placeholder="资源名称" required>
          <select name="resource_type">
            <option value="lesson_plan">教案</option>
            <option value="guide_card">指南卡</option>
            <option value="template">模板</option>
            <option value="courseware">课件</option>
            <option value="video">视频</option>
            <option value="other">其他</option>
          </select>
          <input type="file" name="file" required>
          <button type="submit" class="btn btn-sm btn-primary">上传</button>
        </form>
      <% } %>
    </div>
  </div>

  <div class="detail-sidebar">
    <!-- 已报名学生 -->
    <div class="info-block">
      <h4>👨‍🎓 参与学生（<%= enrollments.length %>人）</h4>
      <% if (enrollments.length > 0) { %>
        <ul class="student-mini-list">
          <% enrollments.forEach(e => { %>
            <li>
              <a href="/students/<%= e.student_id %>"><%= e.student_name %></a>
              <% if (e.school_name) { %><span class="text-muted"><%= e.school_name %></span><% } %>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p class="text-muted">暂无学生报名</p>
      <% } %>
    </div>

    <div class="info-block">
      <h4>📊 课程信息</h4>
      <table class="info-table">
        <tr><td>总课时</td><td><%= course.total_hours || '未设置' %> 分钟</td></tr>
        <tr><td>创建时间</td><td><%= new Date(course.created_at).toLocaleDateString('zh-CN') %></td></tr>
        <tr><td>状态</td><td><span class="status-badge status-<%= course.status %>"><%= {draft:'草稿',published:'已发布',archived:'已归档'}[course.status] %></span></td></tr>
      </table>
    </div>
  </div>
</div>
