
<div class="page-header">
  <a href="/courses" class="btn btn-ghost">← 返回列表</a>
</div>

<% if (typeof errors !== 'undefined' && errors.length > 0) { %>
  <% errors.forEach(err => { %>
    <div class="alert alert-error"><%= err %></div>
  <% }) %>
<% } %>

<div class="form-container">
  <form method="POST" action="/courses/create" class="standard-form">
    <div class="form-section">
      <h3>基本信息</h3>
      <div class="form-group">
        <label for="title">课程名称 <span class="required">*</span></label>
        <input type="text" id="title" name="title" value="<%= course.title || '' %>" placeholder="例如：月球基地设计师" required>
      </div>
      <div class="form-group">
        <label for="theme">主题</label>
        <input type="text" id="theme" name="theme" value="<%= course.theme || '' %>" placeholder="例如：月球基地、无人机救援、未来机场">
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="grade_level">适用学段 <span class="required">*</span></label>
          <select id="grade_level" name="grade_level" required>
            <option value="">请选择</option>
            <option value="primary" <%= course.grade_level === 'primary' ? 'selected' : '' %>>小学（3-6年级）</option>
            <option value="junior" <%= course.grade_level === 'junior' ? 'selected' : '' %>>初中（7-9年级）</option>
            <option value="senior" <%= course.grade_level === 'senior' ? 'selected' : '' %>>高中（10-12年级）</option>
          </select>
        </div>
        <div class="form-group">
          <label for="difficulty">难度等级 <span class="required">*</span></label>
          <select id="difficulty" name="difficulty" required>
            <option value="">请选择</option>
            <option value="basic" <%= course.difficulty === 'basic' ? 'selected' : '' %>>基础版</option>
            <option value="advanced" <%= course.difficulty === 'advanced' ? 'selected' : '' %>>进阶版</option>
            <option value="challenge" <%= course.difficulty === 'challenge' ? 'selected' : '' %>>挑战版</option>
          </select>
        </div>
        <div class="form-group">
          <label for="total_hours">总课时（分钟）</label>
          <input type="number" id="total_hours" name="total_hours" value="<%= course.total_hours || '' %>" placeholder="例如：180" min="1">
        </div>
      </div>
    </div>

    <div class="form-section">
      <h3>课程内容</h3>
      <div class="form-group">
        <label for="driving_question">驱动问题</label>
        <input type="text" id="driving_question" name="driving_question" value="<%= course.driving_question || '' %>" placeholder="一个开放、有挑战性的核心问题，例如：如何为宇航员设计一个能在月球上安全生活的基地？">
      </div>
      <div class="form-group">
        <label for="story_line">故事线</label>
        <textarea id="story_line" name="story_line" rows="3" placeholder="描述课程的故事背景和任务情境"><%= course.story_line || '' %></textarea>
      </div>
      <div class="form-group">
        <label for="description">课程简介</label>
        <textarea id="description" name="description" rows="4" placeholder="简要描述这门课程的内容和目标"><%= course.description || '' %></textarea>
      </div>
      <div class="form-group">
        <label for="materials_needed">材料清单</label>
        <textarea id="materials_needed" name="materials_needed" rows="3" placeholder="每行一个材料项"><%= course.materials_needed || '' %></textarea>
      </div>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">创建课程</button>
      <a href="/courses" class="btn btn-ghost">取消</a>
    </div>
  </form>
</div>
