
<div class="page-header">
  <div class="header-actions">
    <% if (['admin', 'executive_mentor', 'academic_mentor'].includes(user.role)) { %>
      <a href="/courses/create" class="btn btn-primary">+ 创建课程</a>
    <% } %>
  </div>
</div>

<!-- 筛选栏 -->
<div class="filter-bar">
  <form method="GET" action="/courses" class="filter-form">
    <select name="theme">
      <option value="">全部主题</option>
      <% themes.forEach(t => { %>
        <option value="<%= t.theme %>" <%= filters.theme === t.theme ? 'selected' : '' %>><%= t.theme %></option>
      <% }) %>
    </select>
    <select name="grade_level">
      <option value="">全部学段</option>
      <option value="primary" <%= filters.grade_level === 'primary' ? 'selected' : '' %>>小学</option>
      <option value="junior" <%= filters.grade_level === 'junior' ? 'selected' : '' %>>初中</option>
      <option value="senior" <%= filters.grade_level === 'senior' ? 'selected' : '' %>>高中</option>
    </select>
    <select name="difficulty">
      <option value="">全部难度</option>
      <option value="basic" <%= filters.difficulty === 'basic' ? 'selected' : '' %>>基础版</option>
      <option value="advanced" <%= filters.difficulty === 'advanced' ? 'selected' : '' %>>进阶版</option>
      <option value="challenge" <%= filters.difficulty === 'challenge' ? 'selected' : '' %>>挑战版</option>
    </select>
    <button type="submit" class="btn btn-sm">筛选</button>
    <a href="/courses" class="btn btn-sm btn-ghost">重置</a>
  </form>
</div>

<!-- 课程卡片 -->
<div class="course-grid">
  <% if (courses.length === 0) { %>
    <div class="empty-state">
      <p>📭 还没有课程，<a href="/courses/create">创建第一个</a></p>
    </div>
  <% } %>

  <% courses.forEach(course => { %>
    <div class="course-card">
      <div class="course-card-header">
        <h3 class="course-title">
          <a href="/courses/<%= course.id %>"><%= course.title %></a>
        </h3>
        <span class="status-badge status-<%= course.status %>">
          <% const statusNames = {draft:'草稿',published:'已发布',archived:'已归档'} %>
          <%= statusNames[course.status] %>
        </span>
      </div>
      <div class="course-meta">
        <% if (course.theme) { %><span class="tag"><%= course.theme %></span><% } %>
        <% const gradeMap = {primary:'小学',junior:'初中',senior:'高中'} %>
        <span class="tag"><%= gradeMap[course.grade_level] %></span>
        <% const diffMap = {basic:'基础版',advanced:'进阶版',challenge:'挑战版'} %>
        <span class="tag tag-<%= course.difficulty %>"><%= diffMap[course.difficulty] %></span>
      </div>
      <% if (course.description) { %>
        <p class="course-desc"><%= course.description.substring(0, 100) %><%= course.description.length > 100 ? '...' : '' %></p>
      <% } %>
      <div class="course-footer">
        <span class="course-creator">创建者：<%= course.creator_name %></span>
        <span class="course-students"><%= course.student_count %> 名学生</span>
      </div>
    </div>
  <% }) %>
</div>
