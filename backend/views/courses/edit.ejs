
<div class="page-header">
  <a href="/courses/<%= course.id %>" class="btn btn-ghost">← 返回详情</a>
</div>

<% if (typeof errors !== 'undefined' && errors.length > 0) { %>
  <% errors.forEach(err => { %>
    <div class="alert alert-error"><%= err %></div>
  <% }) %>
<% } %>

<div class="form-container">
  <form method="POST" action="/courses/<%= course.id %>/edit" class="standard-form">
    <div class="form-section">
      <h3>基本信息</h3>
      <div class="form-group">
        <label for="title">课程名称</label>
        <input type="text" id="title" name="title" value="<%= course.title %>" required>
      </div>
      <div class="form-group">
        <label for="theme">主题</label>
        <input type="text" id="theme" name="theme" value="<%= course.theme || '' %>">
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="grade_level">适用学段</label>
          <select id="grade_level" name="grade_level">
            <option value="primary" <%= course.grade_level === 'primary' ? 'selected' : '' %>>小学</option>
            <option value="junior" <%= course.grade_level === 'junior' ? 'selected' : '' %>>初中</option>
            <option value="senior" <%= course.grade_level === 'senior' ? 'selected' : '' %>>高中</option>
          </select>
        </div>
        <div class="form-group">
          <label for="difficulty">难度等级</label>
          <select id="difficulty" name="difficulty">
            <option value="basic" <%= course.difficulty === 'basic' ? 'selected' : '' %>>基础版</option>
            <option value="advanced" <%= course.difficulty === 'advanced' ? 'selected' : '' %>>进阶版</option>
            <option value="challenge" <%= course.difficulty === 'challenge' ? 'selected' : '' %>>挑战版</option>
          </select>
        </div>
        <div class="form-group">
          <label for="total_hours">总课时（分钟）</label>
          <input type="number" id="total_hours" name="total_hours" value="<%= course.total_hours || '' %>">
        </div>
      </div>
      <div class="form-group">
        <label for="status">状态</label>
        <select id="status" name="status">
          <option value="draft" <%= course.status === 'draft' ? 'selected' : '' %>>草稿</option>
          <option value="published" <%= course.status === 'published' ? 'selected' : '' %>>已发布</option>
          <option value="archived" <%= course.status === 'archived' ? 'selected' : '' %>>已归档</option>
        </select>
      </div>
    </div>

    <div class="form-section">
      <h3>课程内容</h3>
      <div class="form-group">
        <label for="driving_question">驱动问题</label>
        <input type="text" id="driving_question" name="driving_question" value="<%= course.driving_question || '' %>">
      </div>
      <div class="form-group">
        <label for="story_line">故事线</label>
        <textarea id="story_line" name="story_line" rows="3"><%= course.story_line || '' %></textarea>
      </div>
      <div class="form-group">
        <label for="description">课程简介</label>
        <textarea id="description" name="description" rows="4"><%= course.description || '' %></textarea>
      </div>
      <div class="form-group">
        <label for="materials_needed">材料清单</label>
        <textarea id="materials_needed" name="materials_needed" rows="3"><%= course.materials_needed || '' %></textarea>
      </div>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">保存修改</button>
      <a href="/courses/<%= course.id %>" class="btn btn-ghost">取消</a>
    </div>
  </form>
</div>
