<div class="page-header no-print">
  <a href="/archives" class="btn btn-ghost">返回</a>
  <button onclick="window.print()" class="btn btn-primary">打印/导出</button>
</div>

<div class="archive-document">
  <div class="archive-header">
    <h1><%= scopeName %></h1>
    <h2>学生成长档案批量导出</h2>
    <p class="archive-date">生成时间：<%= generatedAt %></p>
  </div>

  <% if (archives.length === 0) { %>
    <div class="empty-state">
      <p>没有符合条件的成长档案</p>
    </div>
  <% } %>

  <% archives.forEach((item, index) => { %>
    <div class="archive-student-page" style="<%= index > 0 ? 'page-break-before: always;' : '' %>">
      <div class="archive-section">
        <h3><%= index + 1 %>. <%= item.student.real_name %> - 基本信息</h3>
        <table class="archive-table">
          <tr>
            <td class="label">姓名</td>
            <td><%= item.student.real_name %></td>
          </tr>
          <tr>
            <td class="label">学校</td>
            <td><%= item.student.school_name || '-' %></td>
            <td class="label">班级</td>
            <td><%= item.student.class_name ? item.student.class_name + ' (' + (item.student.grade || '') + ')' : '-' %></td>
          </tr>
          <tr>
            <td class="label">邮箱</td>
            <td><%= item.student.email || '-' %></td>
            <td class="label">手机</td>
            <td><%= item.student.phone || '-' %></td>
          </tr>
        </table>
      </div>

      <div class="archive-section">
        <h3>课程参与记录（<%= item.courses.length %>门）</h3>
        <% if (item.courses.length === 0) { %>
          <p>暂无课程参与记录</p>
        <% } else { %>
          <table class="archive-table full-width">
            <thead><tr><th>课程名称</th><th>主题</th><th>学段</th><th>难度</th><th>报名时间</th><th>完成状态</th></tr></thead>
            <tbody>
              <% item.courses.forEach(c => { %>
                <tr>
                  <td><%= c.title %></td>
                  <td><%= c.theme || '-' %></td>
                  <td><%= {primary:'小学',junior:'初中',senior:'高中'}[c.grade_level] || '-' %></td>
                  <td><%= {basic:'基础版',advanced:'进阶版',challenge:'挑战版'}[c.difficulty] || '-' %></td>
                  <td><%= new Date(c.enrolled_at).toLocaleDateString('zh-CN') %></td>
                  <td><%= c.completed_at ? '已完成' : '进行中' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>

      <div class="archive-section">
        <h3>项目作品（<%= item.works.length %>件）</h3>
        <% if (item.works.length === 0) { %>
          <p>暂无作品</p>
        <% } else { %>
          <% item.works.forEach(w => { %>
            <div class="archive-work-item">
              <h4><%= w.title %></h4>
              <p><strong>提交时间：</strong><%= new Date(w.created_at).toLocaleString('zh-CN') %></p>
              <% if (w.description) { %><p><strong>描述：</strong><%= w.description %></p><% } %>
              <% if (w.review_status) { %>
                <p><strong>审核状态：</strong><%= w.review_status === 'pending' ? '待审核' : w.review_status === 'approved' ? '已通过' : '已打回' %></p>
              <% } %>
            </div>
          <% }) %>
        <% } %>
      </div>

      <div class="archive-section">
        <h3>反思日志（<%= item.reflections.length %>条）</h3>
        <% if (item.reflections.length === 0) { %>
          <p>暂无反思记录</p>
        <% } else { %>
          <% item.reflections.forEach(r => { %>
            <div class="archive-reflection">
              <h4><%= r.lesson_title || '反思日志' %> - <%= new Date(r.created_at).toLocaleDateString('zh-CN') %></h4>
              <% if (r.difficulty) { %><p><strong>遇到的困难：</strong><%= r.difficulty %></p><% } %>
              <% if (r.solution) { %><p><strong>解决方法：</strong><%= r.solution %></p><% } %>
              <% if (r.improvement) { %><p><strong>改进方向：</strong><%= r.improvement %></p><% } %>
              <% if (r.new_question) { %><p><strong>新发现的问题：</strong><%= r.new_question %></p><% } %>
            </div>
          <% }) %>
        <% } %>
      </div>

      <div class="archive-section">
        <h3>评价记录（<%= item.evaluations.length %>条）</h3>
        <% if (item.evaluations.length === 0) { %>
          <p>暂无评价记录</p>
        <% } else { %>
          <table class="archive-table full-width">
            <thead><tr><th>评价人</th><th>类型</th><th>评分</th><th>评语</th><th>时间</th></tr></thead>
            <tbody>
              <% item.evaluations.forEach(ev => { %>
                <tr>
                  <td><%= ev.evaluator_name %></td>
                  <td><%= {process:'过程评价',outcome:'成果评价',peer:'同伴互评',self:'自评'}[ev.eval_type] || ev.eval_type %></td>
                  <td><%= ev.score || '-' %></td>
                  <td><%= ev.comment || '-' %></td>
                  <td><%= new Date(ev.created_at).toLocaleDateString('zh-CN') %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    </div>
  <% }) %>
</div>

<style>
@media print {
  .no-print, .sidebar, .top-header { display: none !important; }
  .main-content { margin-left: 0 !important; padding: 0 !important; }
  .archive-document { box-shadow: none; }
  .archive-student-page { page-break-before: always; }
}
</style>
