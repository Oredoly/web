
<div class="page-header">
  <h2>成长档案导出</h2>
</div>

<div class="info-block">
  <p>选择学生生成其完整的成长档案，包含参与课程、作品、反思日志和评价记录。</p>
</div>

<% if (typeof students !== 'undefined' && students.length === 0) { %>
  <div class="empty-state">
    <p>📭 还没有学生数据</p>
  </div>
<% } else { %>
  <div class="student-export-list">
    <% if (typeof students !== 'undefined') { %>
      <% students.forEach(s => { %>
        <div class="export-card">
          <div class="export-card-info">
            <strong><%= s.real_name %></strong>
            <span><%= s.school_name || '未关联学校' %></span>
            <span><%= s.class_name ? s.class_name + ' ' + (s.grade || '') : '' %></span>
          </div>
          <a href="/archives/generate?student_id=<%= s.id %>" class="btn btn-primary btn-sm">生成档案</a>
        </div>
      <% }) %>
    <% } %>
  </div>
<% } %>
