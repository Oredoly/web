
<div class="page-header">
  <h2>填写反思日志</h2>
</div>

<div class="form-container">
  <form method="POST" action="/archives/reflection" class="standard-form">
    <div class="form-section">
      <h3>PBL 反思日志</h3>
      <p class="text-muted">每次课程结束后，花几分钟回顾你的学习过程。答案没有对错，诚实反思最重要。</p>

      <% if (isMentor) { %>
        <div class="form-group">
          <label for="student_id">选择学生</label>
          <select id="student_id" name="student_id" required>
            <option value="">请选择</option>
            <% enrollments.forEach(e => { %>
              <option value="<%= e.student_id %>"><%= e.student_name %></option>
            <% }) %>
          </select>
        </div>
      <% } %>

      <div class="form-group">
        <label for="enrollment_id">关联课程</label>
        <select id="enrollment_id" name="enrollment_id">
          <option value="">不关联课程</option>
          <% enrollments.forEach(e => { %>
            <option value="<%= e.enrollment_id %>"><%= e.course_title %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label for="difficulty">① 今天你遇到的最大困难是什么？</label>
        <textarea id="difficulty" name="difficulty" rows="3" placeholder="描述你遇到的挑战..."></textarea>
      </div>

      <div class="form-group">
        <label for="solution">② 你是怎么解决的？</label>
        <textarea id="solution" name="solution" rows="3" placeholder="你用了什么方法？向谁求助了？"></textarea>
      </div>

      <div class="form-group">
        <label for="improvement">③ 如果再做一次，你会怎么做？</label>
        <textarea id="improvement" name="improvement" rows="3" placeholder="有什么可以改进的地方？"></textarea>
      </div>

      <div class="form-group">
        <label for="new_question">④ 你从今天的活动中发现了什么新问题？</label>
        <textarea id="new_question" name="new_question" rows="3" placeholder="有什么让你好奇的新问题？"></textarea>
      </div>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">提交反思日志</button>
    </div>
  </form>
</div>
