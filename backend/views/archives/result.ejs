
<div class="page-header no-print">
  <a href="/archives" class="btn btn-ghost">← 返回</a>
  <button onclick="window.print()" class="btn btn-primary">🖨️ 打印档案</button>
</div>

<div class="archive-document">
  <div class="archive-header">
    <h1>全重实验室"大中小贯通科创育人"项目</h1>
    <h2>学生成长档案</h2>
    <p class="archive-date">生成时间：<%= generatedAt %></p>
  </div>

  <!-- 基本信息 -->
  <div class="archive-section">
    <h3>一、基本信息</h3>
    <table class="archive-table">
      <tr><td class="label">姓名</td><td><%= student.real_name %></td></tr>
      <tr><td class="label">学校</td><td><%= student.school_name || '-' %></td><td class="label">班级</td><td><%= student.class_name ? student.class_name + ' (' + (student.grade || '') + ')' : '-' %></td></tr>
      <tr><td class="label">邮箱</td><td><%= student.email || '-' %></td><td class="label">手机</td><td><%= student.phone || '-' %></td></tr>
    </table>
  </div>

  <!-- 参与课程 -->
  <div class="archive-section">
    <h3>二、PBL 课程参与记录（<%= courses.length %>门）</h3>
    <% if (courses.length === 0) { %>
      <p>暂无课程参与记录</p>
    <% } else { %>
      <table class="archive-table full-width">
        <thead><tr><th>课程名称</th><th>主题</th><th>学段</th><th>难度</th><th>报名时间</th><th>完成状态</th></tr></thead>
        <tbody>
          <% courses.forEach(c => { %>
            <tr>
              <td><%= c.title %></td>
              <td><%= c.theme || '-' %></td>
              <td><%= {primary:'小学',junior:'初中',senior:'高中'}[c.grade_level] || '-' %></td>
              <td><%= {basic:'基础版',advanced:'进阶版',challenge:'挑战版'}[c.difficulty] || '-' %></td>
              <td><%= new Date(c.enrolled_at).toLocaleDateString('zh-CN') %></td>
              <td><%= c.completed_at ? '已完成' : '进行中' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>

  <!-- 作品 -->
  <div class="archive-section">
    <h3>三、项目作品（<%= works.length %>件）</h3>
    <% if (works.length === 0) { %>
      <p>暂无作品</p>
    <% } else { %>
      <% works.forEach((w, i) => { %>
        <div class="archive-work-item">
          <h4>作品 <%= i+1 %>：<%= w.title %></h4>
          <p><strong>提交时间：</strong><%= new Date(w.created_at).toLocaleString('zh-CN') %></p>
          <% if (w.description) { %><p><strong>描述：</strong><%= w.description %></p><% } %>
          <p><strong>文件类型：</strong><%= w.file_type || '未知' %></p>
        </div>
      <% }) %>
    <% } %>
  </div>

  <!-- 反思日志 -->
  <div class="archive-section">
    <h3>四、反思日志（<%= reflections.length %>条）</h3>
    <% if (reflections.length === 0) { %>
      <p>暂无反思记录</p>
    <% } else { %>
      <% reflections.forEach((r, i) => { %>
        <div class="archive-reflection">
          <h4>反思 <%= i+1 %><% if (r.lesson_title) { %> - <%= r.lesson_title %><% } %></h4>
          <p><strong>时间：</strong><%= new Date(r.created_at).toLocaleDateString('zh-CN') %></p>
          <% if (r.difficulty) { %><p><strong>遇到的困难：</strong><%= r.difficulty %></p><% } %>
          <% if (r.solution) { %><p><strong>解决方案：</strong><%= r.solution %></p><% } %>
          <% if (r.improvement) { %><p><strong>改进方向：</strong><%= r.improvement %></p><% } %>
          <% if (r.new_question) { %><p><strong>新发现的问题：</strong><%= r.new_question %></p><% } %>
        </div>
      <% }) %>
    <% } %>
  </div>

  <!-- 评价 -->
  <div class="archive-section">
    <h3>五、评价记录（<%= evaluations.length %>条）</h3>
    <% if (evaluations.length === 0) { %>
      <p>暂无评价</p>
    <% } else { %>
      <table class="archive-table full-width">
        <thead><tr><th>评价者</th><th>类型</th><th>评分</th><th>评语</th><th>时间</th></tr></thead>
        <tbody>
          <% evaluations.forEach(ev => { %>
            <tr>
              <td><%= ev.evaluator_name %></td>
              <td><%= {process:'过程评价',outcome:'成果评价',peer:'同伴互评',self:'自评'}[ev.eval_type] %></td>
              <td><%= ev.score || '-' %></td>
              <td><%= ev.comment || '-' %></td>
              <td><%= new Date(ev.created_at).toLocaleDateString('zh-CN') %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>

  <div class="archive-footer">
    <p>本档案由 PBL 科创育人数字化平台自动生成</p>
    <p>全重实验室 · 大中小贯通科创育人项目组</p>
  </div>
</div>

<style>
@media print {
  .no-print, .sidebar, .top-header { display: none !important; }
  .main-content { margin-left: 0 !important; padding: 0 !important; }
  .archive-document { box-shadow: none; }
}
</style>
