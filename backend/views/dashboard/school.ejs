<div class="page-header">
  <a href="/dashboard" class="btn btn-ghost">返回工作台</a>
</div>

<div class="info-block">
  <h2><%= school.name %></h2>
  <p class="text-muted">该学校是项目面向学校，可用于学生账号注册时选择。</p>
  <% if (school.description) { %>
    <div class="school-intro">
      <span>学校简介</span>
      <p><%= school.description %></p>
    </div>
  <% } %>
  <% if (school.tags) { %>
    <div class="school-tags">
      <% school.tags.split(',').forEach(tag => { %>
        <% if (tag.trim()) { %><span class="tag"><%= tag.trim() %></span><% } %>
      <% }) %>
    </div>
  <% } %>
  <div class="school-detail-grid">
    <div><span>地区</span><strong><%= school.region || '-' %></strong></div>
    <div><span>联系人</span><strong><%= school.contact_person || '-' %></strong></div>
    <div><span>联系电话</span><strong><%= school.contact_phone || '-' %></strong></div>
    <div><span>班级数</span><strong><%= school.class_count || 0 %></strong></div>
    <div><span>用户数</span><strong><%= school.user_count || 0 %></strong></div>
  </div>
</div>

<div class="info-block">
  <h4>班级列表</h4>
  <% if (classes.length === 0) { %>
    <p class="text-muted">暂无班级，请在下方添加。</p>
  <% } else { %>
    <table class="data-table">
      <thead>
        <tr>
          <th>班级名称</th>
          <th>年级</th>
          <th>学生数</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody>
        <% classes.forEach(c => { %>
          <tr>
            <td><%= c.name %></td>
            <td><%= c.grade || '-' %></td>
            <td><%= c.student_count || 0 %></td>
            <td>
              <form method="POST" action="/dashboard/schools/<%= school.id %>/classes/<%= c.id %>/delete" style="display:inline" onsubmit="return confirm('确认删除该班级？')">
                <button type="submit" class="btn btn-sm btn-danger">删除</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<div class="info-block">
  <h4>添加班级</h4>
  <form method="POST" action="/dashboard/schools/<%= school.id %>/classes" class="inline-form">
    <input type="text" name="name" placeholder="班级名称" required>
    <input type="text" name="grade" placeholder="年级（可选）">
    <button type="submit" class="btn btn-primary">添加班级</button>
  </form>
</div>

<style>
.school-detail-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 10px; margin-top: 12px; }
.school-detail-grid div { background: #fafbfc; border: 1px solid #e8eaed; border-radius: 8px; padding: 10px 12px; }
.school-detail-grid span { display: block; font-size: 12px; color: #5f6368; margin-bottom: 4px; }
.school-detail-grid strong { font-size: 14px; }
.school-intro { margin-top: 12px; padding: 12px; background: #fafbfc; border: 1px solid #e8eaed; border-radius: 8px; }
.school-intro span { font-size: 12px; color: #5f6368; display: block; margin-bottom: 4px; }
.school-intro p { margin: 0; font-size: 14px; line-height: 1.6; }
.school-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
</style>
