<div class="page-header">
  <a href="/dashboard" class="btn btn-ghost">返回工作台</a>
</div>

<% if (typeof errors !== 'undefined' && errors.length > 0) { %>
  <% errors.forEach(err => { %>
    <div class="alert alert-error"><%= err %></div>
  <% }) %>
<% } %>

<div class="form-container">
  <form method="POST" action="/dashboard/schools" class="standard-form">
    <div class="form-section">
      <h3>学校基本信息</h3>
      <div class="form-group">
        <label for="name">学校名称 <span class="required">*</span></label>
        <input type="text" id="name" name="name" placeholder="请输入学校名称" required>
      </div>
      <div class="form-group">
        <label for="description">学校简介</label>
        <textarea id="description" name="description" rows="4" placeholder="请输入学校简介"></textarea>
      </div>
      <div class="form-group">
        <label for="tags">学校标签</label>
        <input type="text" id="tags" name="tags" placeholder="多个标签用逗号分隔，例如：小学, 科创, 示范校">
      </div>
    </div>

    <div class="form-section">
      <h3>联系信息</h3>
      <div class="form-row">
        <div class="form-group">
          <label for="region">地区</label>
          <input type="text" id="region" name="region" placeholder="例如：北京市海淀区">
        </div>
        <div class="form-group">
          <label for="contact_person">负责人</label>
          <input type="text" id="contact_person" name="contact_person" placeholder="负责人姓名">
        </div>
      </div>
      <div class="form-group">
        <label for="contact_phone">负责人电话</label>
        <input type="text" id="contact_phone" name="contact_phone" placeholder="负责人联系电话">
      </div>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">保存学校</button>
      <a href="/dashboard" class="btn btn-ghost">取消</a>
    </div>
  </form>
</div>
