<div class="auth-card">
  <div class="auth-logos">
    <img src="/images/beihang_logo_black.png" alt="北京航空航天大学" class="auth-logo-img">
  </div>
  <div class="auth-header">
    <h2>PBL 科创育人平台</h2>
    <p class="auth-subtitle">大中小贯通 · 项目式学习数字化平台</p>
  </div>

  <% if (typeof success_msg !== 'undefined' && success_msg.length > 0) { %>
    <div class="alert alert-success"><%= success_msg %></div>
  <% } %>
  <% if (typeof error_msg !== 'undefined' && error_msg.length > 0) { %>
    <div class="alert alert-error"><%= error_msg %></div>
  <% } %>

  <form method="POST" action="/auth/login" class="auth-form">
    <div class="form-group">
      <label for="real_name">姓名</label>
      <input type="text" id="real_name" name="real_name" placeholder="请输入姓名" required>
    </div>
    <div class="form-group">
      <label for="password">密码</label>
      <input type="password" id="password" name="password" placeholder="请输入密码" required>
    </div>
    <button type="submit" class="btn btn-primary btn-block">登 录</button>
  </form>

  <div class="auth-footer">
    还没有账号？<a href="/auth/register">立即注册</a>
  </div>
</div>
