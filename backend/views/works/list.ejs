
<div class="page-header">
  <div class="header-actions">
    <% if (user.role !== 'admin') { %>
      <a href="/works/upload" class="btn btn-primary">+ 上传作品</a>
    <% } %>
  </div>
</div>

<!-- 筛选 -->
<div class="filter-bar">
  <form method="GET" action="/works" class="filter-form">
    <% if (typeof courses !== 'undefined') { %>
      <select name="course_id">
        <option value="">全部课程</option>
        <% courses.forEach(c => { %>
          <option value="<%= c.id %>" <%= filters.course_id == c.id ? 'selected' : '' %>><%= c.title %></option>
        <% }) %>
      </select>
    <% } %>
    <input type="text" name="search" placeholder="搜索作品名称" value="<%= filters.search || '' %>">
    <button type="submit" class="btn btn-sm">搜索</button>
    <a href="/works" class="btn btn-sm btn-ghost">重置</a>
  </form>
</div>

<% if (works.length === 0) { %>
  <div class="empty-state">
    <% if (user.role === 'admin') { %>
      <p>📭 还没有作品</p>
    <% } else { %>
      <p>📭 还没有作品，<a href="/works/upload">上传第一个</a></p>
    <% } %>
  </div>
<% } else { %>
  <div class="work-grid">
    <% works.forEach(w => { %>
      <div class="work-card">
        <div class="work-preview">
          <% if (w.file_type === 'image') { %>
            <img src="/<%= w.file_path.replace(/\\/g, '/') %>" alt="<%= w.title %>">
          <% } else if (w.file_type === 'video') { %>
            <div class="work-type-icon">🎬</div>
          <% } else if (w.file_type === 'pdf') { %>
            <div class="work-type-icon">📕</div>
          <% } else { %>
            <div class="work-type-icon">📄</div>
          <% } %>
        </div>
        <div class="work-info">
          <h4><a href="/works/<%= w.id %>"><%= w.title %></a></h4>
          <p class="work-author">👤 <%= w.student_name %></p>
          <p class="work-course">📚 <%= w.course_title || '未关联课程' %></p>
          <% if (w.description) { %>
            <p class="work-desc"><%= w.description.substring(0, 60) %><%= w.description.length > 60 ? '...' : '' %></p>
          <% } %>
          <div class="work-footer">
            <span class="text-muted"><%= new Date(w.created_at).toLocaleDateString('zh-CN') %></span>
            <% if (w.review_status) { %>
              <span class="status-badge status-<%= w.review_status %>"><%= w.review_status === 'pending' ? '待审核' : w.review_status === 'approved' ? '已通过' : '已打回' %></span>
            <% } %>
            <% if (user.role === 'admin' && w.review_status !== 'rejected') { %>
              <form method="POST" action="/works/<%= w.id %>/reject" class="inline-form">
                <input type="text" name="reason" placeholder="打回原因" style="width:130px">
                <button type="submit" class="btn btn-sm">打回</button>
              </form>
            <% } %>
            <% if (user.id === w.student_id || ['admin', 'executive_mentor', 'academic_mentor', 'teacher'].includes(user.role)) { %>
              <form method="POST" action="/works/<%= w.id %>/delete" style="display:inline" onsubmit="return confirm('确定删除此作品？')">
                <button type="submit" class="btn btn-sm btn-danger">删除</button>
              </form>
            <% } %>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>
