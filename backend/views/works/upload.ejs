
<div class="page-header">
  <a href="/works" class="btn btn-ghost">← 返回列表</a>
</div>

<div class="form-container">
  <form method="POST" action="/works/upload" enctype="multipart/form-data" class="standard-form">
    <div class="form-section">
      <h3>上传作品</h3>

      <% if (typeof students !== 'undefined' && students.length > 0) { %>
        <div class="form-group">
          <label for="student_id">选择学生（导师模式）</label>
          <select id="student_id" name="student_id">
            <option value="<%= user.id %>">自己</option>
            <% students.forEach(s => { %>
              <option value="<%= s.id %>"><%= s.real_name %></option>
            <% }) %>
          </select>
        </div>
      <% } %>

      <div class="form-group">
        <label for="enrollment_id">关联课程</label>
        <select id="enrollment_id" name="enrollment_id">
          <option value="">不关联课程</option>
          <% courseOptions.forEach(e => { %>
            <option value="<%= e.enrollment_id %>"><%= e.course_title %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label for="title">作品名称 <span class="required">*</span></label>
        <input type="text" id="title" name="title" placeholder="为你的作品取个名字" required>
      </div>

      <div class="form-group">
        <label for="description">作品描述</label>
        <textarea id="description" name="description" rows="3" placeholder="简单描述你的创作思路和过程"></textarea>
      </div>

      <div class="form-group">
        <label for="file">选择文件 <span class="required">*</span></label>
        <input type="file" id="file" name="file" required>
        <p class="form-hint">支持图片、视频、PDF、PPT、Word、3D模型文件，最大 100MB</p>
      </div>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">上传作品</button>
      <a href="/works" class="btn btn-ghost">取消</a>
    </div>
  </form>
</div>
