
<div class="page-header">
  <a href="/works" class="btn btn-ghost">← 返回列表</a>
</div>

<div class="work-detail">
  <div class="work-detail-preview">
    <% if (work.file_type === 'image') { %>
      <img src="/<%= work.file_path.replace(/\\/g, '/') %>" alt="<%= work.title %>" style="max-width:100%; border-radius:8px;">
    <% } else { %>
      <div class="work-preview-large">
        <span class="work-type-big"><%= {video:'🎬',pdf:'📕',file:'📄'}[work.file_type] || '📄' %></span>
        <a href="/<%= work.file_path.replace(/\\/g, '/') %>" target="_blank" class="btn btn-primary">下载查看</a>
      </div>
    <% } %>
  </div>

  <div class="work-detail-info">
    <h2><%= work.title %></h2>
    <div class="work-meta">
      <span>👤 作者：<%= work.student_name %></span>
      <span>📚 课程：<%= work.course_title || '未关联' %></span>
      <% if (work.task_title) { %><span>📋 任务：<%= work.task_title %></span><% } %>
      <span>🕐 <%= new Date(work.created_at).toLocaleString('zh-CN') %></span>
    </div>
    <% if (work.review_status) { %>
      <div class="work-review">
        <span class="status-badge status-<%= work.review_status %>"><%= work.review_status === 'pending' ? '待审核' : work.review_status === 'approved' ? '已通过' : '已打回' %></span>
        <% if (work.review_status === 'rejected' && work.reject_reason) { %>
          <p>打回原因：<%= work.reject_reason %></p>
        <% } %>
      </div>
    <% } %>
    <% if (user.role === 'admin' && work.review_status !== 'rejected') { %>
      <form method="POST" action="/works/<%= work.id %>/reject" class="inline-form">
        <input type="text" name="reason" placeholder="打回原因">
        <button type="submit" class="btn btn-sm">打回作品</button>
      </form>
    <% } %>
    <% if (work.description) { %>
      <div class="work-description">
        <h4>作品描述</h4>
        <p><%= work.description %></p>
      </div>
    <% } %>
  </div>
</div>
