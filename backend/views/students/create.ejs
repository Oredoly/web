
<div class="page-header">
  <a href="/students" class="btn btn-ghost">← 返回列表</a>
</div>

<% if (typeof errors !== 'undefined' && errors.length > 0) { %>
  <% errors.forEach(err => { %>
    <div class="alert alert-error"><%= err %></div>
  <% }) %>
<% } %>

<div class="form-container">
  <form method="POST" action="/students/create" class="standard-form">
    <div class="form-section">
      <h3>学生信息</h3>
      <div class="form-group">
        <label for="real_name">真实姓名 <span class="required">*</span></label>
        <input type="text" id="real_name" name="real_name" placeholder="请输入学生姓名" required>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="password">密码</label>
          <input type="text" id="password" name="password" placeholder="留空默认 pbl123456">
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="email">邮箱</label>
          <input type="email" id="email" name="email" placeholder="选填">
        </div>
        <div class="form-group">
          <label for="phone">手机号</label>
          <input type="text" id="phone" name="phone" placeholder="选填">
        </div>
      </div>
    </div>

    <div class="form-section">
      <h3>所属信息</h3>
      <div class="form-row">
        <div class="form-group">
          <label for="school_id">学校</label>
          <select id="school_id" name="school_id" onchange="loadClasses(this.value)" required>
            <option value="">请选择学校</option>
            <% schools.forEach(s => { %>
              <option value="<%= s.id %>"><%= s.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label for="class_id">班级</label>
          <select id="class_id" name="class_id" required>
            <option value="">请先选择学校</option>
          </select>
        </div>
      </div>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">添加学生</button>
      <a href="/students" class="btn btn-ghost">取消</a>
    </div>
  </form>
</div>

<script>
async function loadClasses(schoolId) {
  const classSelect = document.getElementById('class_id');
  classSelect.innerHTML = '<option value="">加载中...</option>';
  if (!schoolId) {
    classSelect.innerHTML = '<option value="">请先选择学校</option>';
    return;
  }
  try {
    const res = await fetch('/students/classes/' + schoolId);
    const classes = await res.json();
    classSelect.innerHTML = '<option value="">请选择班级（可选）</option>';
    classes.forEach(c => {
      classSelect.innerHTML += `<option value="${c.id}">${c.name} (${c.grade || ''})</option>`;
    });
  } catch(e) {
    classSelect.innerHTML = '<option value="">加载失败</option>';
  }
}
</script>
