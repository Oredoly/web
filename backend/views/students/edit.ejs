<div class="page-header">
  <a href="/students/<%= student.id %>" class="btn btn-ghost">返回学生详情</a>
</div>

<% if (typeof errors !== 'undefined' && errors.length > 0) { %>
  <% errors.forEach(err => { %>
    <div class="alert alert-error"><%= err %></div>
  <% }) %>
<% } %>

<div class="form-container">
  <form method="POST" action="/students/<%= student.id %>/edit" class="standard-form">
    <div class="form-section">
      <h3>学生信息</h3>
      <div class="form-group">
        <label>姓名</label>
        <input type="text" value="<%= student.real_name %>" disabled>
      </div>

      <% if (user.role === 'teacher') { %>
        <input type="hidden" name="school_id" value="<%= student.school_id %>">
        <div class="form-group">
          <label>学校</label>
          <input type="text" value="<%= student.school_name || '-' %>" disabled>
        </div>
      <% } else { %>
        <div class="form-group">
          <label for="school_id">学校 <span class="required">*</span></label>
          <select id="school_id" name="school_id" onchange="loadClasses(this.value)" required>
            <% schools.forEach(s => { %>
              <option value="<%= s.id %>" <%= s.id == student.school_id ? 'selected' : '' %>><%= s.name %></option>
            <% }) %>
          </select>
        </div>
      <% } %>

      <div class="form-group">
        <label for="class_id">班级 <span class="required">*</span></label>
        <select id="class_id" name="class_id" required>
          <% classes.forEach(c => { %>
            <option value="<%= c.id %>" <%= c.id == student.class_id ? 'selected' : '' %>><%= c.name %><% if (c.grade) { %>（<%= c.grade %>）<% } %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">保存</button>
      <a href="/students/<%= student.id %>" class="btn btn-ghost">取消</a>
    </div>
  </form>
</div>

<script>
async function loadClasses(schoolId) {
  const sel = document.getElementById('class_id');
  sel.innerHTML = '<option value="">加载中...</option>';
  const res = await fetch('/students/classes/' + schoolId);
  const classes = await res.json();
  sel.innerHTML = '<option value="">请选择班级</option>';
  classes.forEach(c => {
    sel.innerHTML += '<option value="' + c.id + '">' + c.name + '</option>';
  });
}
</script>
