
<div class="page-header">
  <a href="/students" class="btn btn-ghost">← 返回列表</a>
  <a href="/archives/generate?student_id=<%= student.id %>" class="btn btn-primary">📋 导出成长档案</a>
</div>

<!-- 学生基本信息 -->
<div class="student-profile">
  <div class="profile-avatar"><%= student.real_name.charAt(0) %></div>
  <div class="profile-info">
    <h2><%= student.real_name %></h2>
    <div class="profile-meta">
      <% if (student.school_name) { %><span>🏫 <%= student.school_name %></span><% } %>
      <% if (student.class_name) { %><span>📚 <%= student.class_name %> (<%= student.grade || '' %>)</span><% } %>
      <span>🕐 加入时间：<%= new Date(student.created_at).toLocaleDateString('zh-CN') %></span>
    </div>
  </div>
</div>

<!-- 参与课程 -->
<div class="info-block">
  <h4>📚 参与课程（<%= courses.length %>门）</h4>
  <% if (courses.length === 0) { %>
    <p class="text-muted">尚未参与任何课程</p>
  <% } else { %>
    <table class="data-table">
      <thead><tr><th>课程名称</th><th>主题</th><th>报名时间</th><th>完成时间</th></tr></thead>
      <tbody>
        <% courses.forEach(c => { %>
          <tr>
            <td><%= c.title %></td>
            <td><%= c.theme || '-' %></td>
            <td><%= new Date(c.enrolled_at).toLocaleDateString('zh-CN') %></td>
            <td><%= c.completed_at ? new Date(c.completed_at).toLocaleDateString('zh-CN') : '进行中' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<!-- 作品 -->
<div class="info-block">
  <h4>🎨 作品（<%= works.length %>件）</h4>
  <% if (works.length === 0) { %>
    <p class="text-muted">暂无作品</p>
  <% } else { %>
    <div class="work-mini-grid">
      <% works.forEach(w => { %>
        <div class="work-mini-card">
          <% if (w.file_type === 'image') { %>
            <img src="/<%= w.file_path.replace(/\\/g, '/') %>" alt="<%= w.title %>" class="work-thumb">
          <% } else { %>
            <div class="work-thumb-placeholder">📄</div>
          <% } %>
          <div class="work-mini-info">
            <strong><%= w.title %></strong>
            <span class="text-muted"><%= w.course_title || '' %></span>
            <span class="text-muted"><%= new Date(w.created_at).toLocaleDateString('zh-CN') %></span>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<!-- 反思日志 -->
<div class="info-block">
  <h4>📝 反思日志（<%= reflections.length %>条）</h4>
  <% if (reflections.length === 0) { %>
    <p class="text-muted">暂无反思记录</p>
  <% } else { %>
    <% reflections.forEach(r => { %>
      <div class="reflection-card">
        <div class="reflection-meta">
          <span><%= r.course_title || '' %> - <%= r.lesson_title || '' %></span>
          <span class="text-muted"><%= new Date(r.created_at).toLocaleDateString('zh-CN') %></span>
        </div>
        <% if (r.difficulty) { %><p><strong>遇到的困难：</strong><%= r.difficulty %></p><% } %>
        <% if (r.solution) { %><p><strong>解决方案：</strong><%= r.solution %></p><% } %>
        <% if (r.improvement) { %><p><strong>改进方向：</strong><%= r.improvement %></p><% } %>
        <% if (r.new_question) { %><p><strong>新问题：</strong><%= r.new_question %></p><% } %>
      </div>
    <% }) %>
  <% } %>
</div>

<!-- 评价 -->
<div class="info-block">
  <h4>⭐ 评价记录（<%= evaluations.length %>条）</h4>
  <% if (evaluations.length === 0) { %>
    <p class="text-muted">暂无评价</p>
  <% } else { %>
    <table class="data-table">
      <thead><tr><th>评价者</th><th>类型</th><th>评分</th><th>评语</th><th>时间</th></tr></thead>
      <tbody>
        <% evaluations.forEach(ev => { %>
          <tr>
            <td><%= ev.evaluator_name %></td>
            <td><%= {process:'过程评价',outcome:'成果评价',peer:'同伴互评',self:'自评'}[ev.eval_type] || ev.eval_type %></td>
            <td><%= ev.score || '-' %></td>
            <td><%= ev.comment || '-' %></td>
            <td><%= new Date(ev.created_at).toLocaleDateString('zh-CN') %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<% if (['admin', 'executive_mentor', 'academic_mentor', 'teacher'].includes(user.role)) { %>
  <!-- 添加评价 -->
  <div class="info-block">
    <h4>✏️ 添加评价</h4>
    <form method="POST" action="/archives/evaluation" class="inline-form">
      <input type="hidden" name="student_id" value="<%= student.id %>">
      <select name="eval_type">
        <option value="process">过程评价</option>
        <option value="outcome">成果评价</option>
      </select>
      <input type="number" name="score" placeholder="评分(1-100)" min="1" max="100" style="width:120px">
      <input type="text" name="comment" placeholder="评语">
      <button type="submit" class="btn btn-sm btn-primary">提交评价</button>
    </form>
  </div>
<% } %>
