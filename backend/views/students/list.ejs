
<div class="page-header">
  <div class="header-actions">
    <a href="/students/create" class="btn btn-primary">+ 添加学生</a>
    <a href="/students/import" class="btn btn-sm">批量导入</a>
  </div>
</div>

<!-- 筛选 -->
<div class="filter-bar">
  <form method="GET" action="/students" class="filter-form">
    <select name="school_id" id="filter-school">
      <option value="">全部学校</option>
      <% schools.forEach(s => { %>
        <option value="<%= s.id %>" <%= filters.school_id == s.id ? 'selected' : '' %>><%= s.name %></option>
      <% }) %>
    </select>
    <input type="text" name="search" placeholder="搜索姓名" value="<%= filters.search || '' %>">
    <button type="submit" class="btn btn-sm">搜索</button>
    <a href="/students" class="btn btn-sm btn-ghost">重置</a>
  </form>
</div>

<% if (students.length === 0) { %>
  <div class="empty-state">
    <p>📭 还没有学生数据</p>
    <a href="/students/create" class="btn btn-primary">添加第一个学生</a>
  </div>
<% } else { %>
  <table class="data-table">
    <thead>
      <tr>
        <th>姓名</th>
        <th>学校</th>
        <th>班级/年级</th>
        <th>状态</th>
        <th>添加时间</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% students.forEach(s => { %>
        <tr>
          <td><a href="/students/<%= s.id %>"><strong><%= s.real_name %></strong></a></td>
          <td><%= s.school_name || '-' %></td>
          <td><%= s.class_name ? `${s.class_name} / ${s.grade || ''}` : '-' %></td>
          <td><span class="status-dot <%= s.is_active ? 'active' : 'inactive' %>"></span> <%= s.is_active ? '正常' : '禁用' %></td>
          <td><%= new Date(s.created_at).toLocaleDateString('zh-CN') %></td>
          <td>
            <a href="/students/<%= s.id %>" class="btn btn-sm">查看</a>
            <% if (['admin', 'executive_mentor', 'academic_mentor', 'teacher'].includes(user.role)) { %>
              <a href="/students/<%= s.id %>/edit" class="btn btn-sm">编辑</a>
              <form method="POST" action="/students/<%= s.id %>/delete" style="display:inline" onsubmit="return confirm('确认删除该学生？')">
                <button type="submit" class="btn btn-sm btn-danger">删除</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>
