<aside class="sidebar">
  <div class="sidebar-brand">
    <div class="brand-icon">🚀</div>
    <div class="brand-text">
      <span class="brand-name">PBL 科创育人</span>
      <span class="brand-subtitle">数字化平台</span>
    </div>
  </div>

  <nav class="sidebar-nav">
    <a href="/dashboard" class="nav-item <%= currentPath.startsWith('/dashboard') ? 'active' : '' %>">
      <span class="nav-icon">📊</span> 工作台
    </a>

    <% if (['admin','executive_mentor','academic_mentor','teacher'].includes(user.role)) { %>
    <a href="/courses" class="nav-item <%= currentPath.startsWith('/courses') ? 'active' : '' %>">
      <span class="nav-icon">📚</span> <%= user.role === 'teacher' ? '课程查看' : '课程管理' %>
    </a>
    <% } %>

    <% if (['admin','executive_mentor','academic_mentor','teacher'].includes(user.role)) { %>
    <a href="/students" class="nav-item <%= currentPath.startsWith('/students') ? 'active' : '' %>">
      <span class="nav-icon">👨‍🎓</span> <%= user.role === 'admin' ? '用户管理' : '学生管理' %>
    </a>
    <% } %>

    <a href="/works" class="nav-item <%= currentPath.startsWith('/works') ? 'active' : '' %>">
      <span class="nav-icon">🎨</span> 作品管理
    </a>

    <% if (user.role !== 'student') { %>
    <a href="/archives" class="nav-item <%= currentPath.startsWith('/archives') && currentPath !== '/archives/reflection' ? 'active' : '' %>">
      <span class="nav-icon">📋</span> 成长档案
    </a>
    <% } %>

    <% if (!['admin', 'teacher'].includes(user.role)) { %>
    <a href="/archives/reflection" class="nav-item <%= currentPath === '/archives/reflection' ? 'active' : '' %>">
      <span class="nav-icon">📝</span> 反思日志
    </a>
    <% } %>
  </nav>

  <% if (user.role === 'student' && typeof sidebarMyCount !== 'undefined') { %>
  <div class="sidebar-section">
    <div class="sidebar-section-title">📖 课程选择 <span class="sidebar-limit">(<%= sidebarMyCount || 0 %>/3)</span></div>
    <div class="sidebar-course-list" id="sidebarCourseList">
      <% if (typeof sidebarMyCourses !== 'undefined' && sidebarMyCourses.length > 0) { %>
        <% sidebarMyCourses.forEach(c => { %>
          <div class="sidebar-course-item selected" data-id="<%= c.id %>">
            <span class="sidebar-course-name"><%= c.title %></span>
            <span class="sidebar-course-badge">已选</span>
          </div>
        <% }) %>
      <% } %>
    </div>
    <% if ((sidebarMyCount || 0) < 3) { %>
      <button class="sidebar-add-course-btn" onclick="toggleCoursePicker()">+ 添加课程</button>
    <% } %>
    <!-- 课程选择弹窗 -->
    <div class="sidebar-course-picker" id="coursePicker" style="display:none">
      <div class="picker-header">
        <span>可选课程</span>
        <span class="picker-close" onclick="toggleCoursePicker()">✕</span>
      </div>
      <div class="picker-list" id="pickerList">
        <% if (typeof sidebarAvailableCourses !== 'undefined') { %>
          <% sidebarAvailableCourses.forEach(c => { %>
            <div class="picker-item" data-id="<%= c.id %>" onclick="enrollCourse(<%= c.id %>, this)">
              <div>
                <strong><%= c.title %></strong>
                <span class="picker-meta"><%= {primary:'小学',junior:'初中',senior:'高中'}[c.grade_level] %> · <%= {basic:'基础版',advanced:'进阶版',challenge:'挑战版'}[c.difficulty] %></span>
              </div>
              <span class="picker-add">选课</span>
            </div>
          <% }) %>
        <% } %>
        <% if (!sidebarAvailableCourses || sidebarAvailableCourses.length === 0) { %>
          <div class="picker-empty">暂无可选课程</div>
        <% } %>
      </div>
    </div>
  </div>
  <% } %>

  <div class="sidebar-footer">
    <span class="version">v1.0 MVP</span>
  </div>
</aside>

<script>
function toggleCoursePicker() {
  var p = document.getElementById('coursePicker');
  p.style.display = p.style.display === 'none' ? 'block' : 'none';
}

async function enrollCourse(courseId, el) {
  try {
    var res = await fetch('/courses/enroll', {
      method: 'POST',
      headers: {'Content-Type': 'application/x-www-form-urlencoded'},
      body: 'course_id=' + courseId
    });
    var data = await res.json();
    if (data.success) {
      el.innerHTML = '<span class="picker-added">✓ 已添加</span>';
      el.style.pointerEvents = 'none';
      el.style.opacity = '0.5';
      setTimeout(function(){ location.reload(); }, 600);
    } else {
      alert(data.message || '选课失败');
    }
  } catch(e) {
    alert('操作失败，请稍后重试');
  }
}
</script>

<style>
.sidebar-section { padding: 8px 12px; border-top: 1px solid rgba(255,255,255,0.08); margin-top: 8px; }
.sidebar-section-title { font-size: 11px; color: rgba(255,255,255,0.4); text-transform: uppercase; margin-bottom: 6px; display: flex; justify-content: space-between; }
.sidebar-limit { font-size: 10px; }
.sidebar-course-list { margin-bottom: 6px; }
.sidebar-course-item { padding: 6px 8px; border-radius: 4px; font-size: 12px; display: flex; justify-content: space-between; align-items: center; margin-bottom: 2px; color: rgba(255,255,255,0.7); }
.sidebar-course-item.selected { background: rgba(26,115,232,0.3); color: #fff; }
.sidebar-course-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sidebar-course-badge { font-size: 10px; background: rgba(26,115,232,0.5); padding: 1px 6px; border-radius: 8px; color: #fff; flex-shrink: 0; }
.sidebar-add-course-btn { width: 100%; padding: 5px; background: rgba(255,255,255,0.08); border: 1px dashed rgba(255,255,255,0.2); color: rgba(255,255,255,0.5); border-radius: 4px; font-size: 12px; cursor: pointer; }
.sidebar-add-course-btn:hover { background: rgba(255,255,255,0.12); color: #fff; }

.sidebar-course-picker { position: fixed; left: var(--sidebar-width); bottom: 0; width: 280px; max-height: 60vh; background: #fff; border-radius: 8px 8px 0 0; box-shadow: 0 -4px 20px rgba(0,0,0,0.2); z-index: 200; overflow: hidden; }
.picker-header { display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; border-bottom: 1px solid #e8eaed; font-weight: 600; color: #1a1f36; }
.picker-close { cursor: pointer; font-size: 18px; color: #5f6368; }
.picker-list { overflow-y: auto; max-height: calc(60vh - 44px); }
.picker-item { padding: 12px 16px; border-bottom: 1px solid #e8eaed; cursor: pointer; display: flex; justify-content: space-between; align-items: center; transition: background 0.15s; }
.picker-item:hover { background: #f1f3f4; }
.picker-item strong { font-size: 14px; display: block; }
.picker-meta { font-size: 11px; color: #5f6368; }
.picker-add { color: #1a73e8; font-size: 13px; font-weight: 500; }
.picker-added { color: #0d904f; font-size: 13px; font-weight: 500; }
.picker-empty { padding: 20px; text-align: center; color: #5f6368; font-size: 13px; }
</style>
