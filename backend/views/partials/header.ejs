<header class="top-header">
  <div class="header-left">
    <h1 class="page-title"><%= title %></h1>
  </div>
  <div class="header-right">
    <div class="user-info">
      <span class="user-avatar"><%= user.real_name.charAt(0) %></span>
      <span class="user-name"><%= user.real_name %></span>
      <span class="user-role-badge role-<%= user.role %>">
        <% const roleNames = { admin:'管理员', academic_mentor:'学术导师', executive_mentor:'执行导师', teacher:'教师', student:'学生', media:'新媒体' } %>
        <%= roleNames[user.role] || user.role %>
      </span>
    </div>
    <a href="/auth/logout" class="btn-logout">退出</a>
  </div>
</header>
